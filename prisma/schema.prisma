// DBL HRM — Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  HR_MANAGER
  MANAGEMENT
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeSource {
  ZINGHR
  MANUAL
}

enum SeatCategory {
  OFFICER
  STAFF
  WORKER
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PROFILE_GENERATED
  POSTED
}

enum RequirementType {
  EXISTING
  NEW
}

enum Priority {
  TOP
  MODERATE
  ORDINARY
}

enum EmploymentNature {
  PERMANENT
  TEMPORARY
  CONTRACTUAL
}

enum ApprovalRole {
  DEPARTMENT_HEAD
  FACTORY_HR
  SBU_HEAD
  CORPORATE_HR
  CHRO
}

enum StepStatus {
  PENDING
  APPROVED
  REJECTED
  INFO_REQUESTED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  NEED_MORE_INFO
  ESCALATED
  EDITED
}

/// GLOBAL roles apply org-wide; UNIT roles are scoped to specific units.
enum RoleScope {
  GLOBAL
  UNIT
}

/// Candidate pipeline stage (Phase 2). Mirrors the Drive subfolders.
enum CandidateStage {
  APPLIED
  AI_SHORTLISTED
  SHORTLISTED
  INTERVIEW
  FINAL
  SELECTED
  REJECTED
}

enum InterviewKind {
  FIRST
  SECOND
  FINAL
}

enum InterviewMode {
  ONLINE
  OFFLINE
  PHYSICAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  /// The candidate did not turn up. Distinct from CANCELLED, which is the
  /// company calling it off — this one is a fact about the candidate and the
  /// panel's time, and HR reads the two very differently.
  ABSENT
}

enum EvalTokenStatus {
  sent
  opened
  submitted
}

enum CandidateSource {
  drive
  email
  upload
  manual
  application
  bdjobs
}

enum SyncSource {
  zinghr
}

enum SyncStatus {
  running
  success
  failed
}

enum OnboardingStatus {
  docs_pending
  docs_submitted
  offer_sent
  offer_accepted
  medical
  hr_final
  onboarded
}

enum MedicalStatus {
  pending
  /// The examining officer has recorded a finding and it is waiting on the
  /// Central Medical Officer. NOT cleared: every downstream gate reads
  /// `cleared`, so a candidate sitting here cannot progress, which is the
  /// point of the layer.
  submitted
  cleared
  rejected
}

enum OnboardingDocStatus {
  pending
  verified
  rejected
}

// ---------------------------------------------------------------------------
// Identity & people
// ---------------------------------------------------------------------------

/// Key-value app settings (e.g. AI configuration), editable by super users.
model Setting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model User {
  id                            String                 @id @default(cuid())
  employeeCode                  String                 @unique @map("employee_code") @db.VarChar(20)
  name                          String                 @db.VarChar(150)
  email                         String?                @db.VarChar(254)
  phone                         String?                @db.VarChar(20)
  passwordHash                  String                 @map("password_hash") @db.VarChar(100)
  role                          UserRole               @default(EMPLOYEE)
  status                        UserStatus             @default(ACTIVE)
  /// Bumped on logout / password change to invalidate previously-issued JWTs.
  tokenVersion                  Int                    @default(0) @map("token_version")
  /// E-signature: a roughly 3:1 image, served via the signature proxy.
  signatureFileId               String?                @map("signature_file_id") @db.VarChar(100)
  /// Who put the signature there.
  ///
  /// Deliberately a plain id and not a relation: it is an audit marker, and the
  /// only question ever asked of it is "is this the user's own id" — which
  /// decides whether HR may replace the signature. A person's own signature is
  /// theirs; once they have uploaded it, nobody else overwrites it.
  signatureUploadedById         String?                @map("signature_uploaded_by_id") @db.VarChar(60)
  signatureUploadedAt           DateTime?              @map("signature_uploaded_at")
  /// Google Drive file id of the user's profile picture (served via the avatar proxy).
  avatarFileId                  String?                @map("avatar_file_id") @db.VarChar(100)
  /// Per-user toggle: also send notifications to this user's email.
  emailNotifications            Boolean                @default(true) @map("email_notifications")
  /// Two-factor auth: enabled flag, method ('email' | 'totp'), and TOTP secret.
  twoFactorEnabled              Boolean                @default(false) @map("two_factor_enabled")
  twoFactorMethod               String?                @map("two_factor_method") @db.VarChar(10)
  twoFactorSecret               String?                @map("two_factor_secret") @db.VarChar(100)
  /// Transient one-time code (hashed) for email 2FA + its expiry.
  otpHash                       String?                @map("otp_hash") @db.VarChar(100)
  otpExpiresAt                  DateTime?              @map("otp_expires_at")
  /// The account still holds a password someone else chose for it — the
  /// employee code it was provisioned with, or an administrator's reset.
  /// Until it is changed the session may only change the password or sign out.
  mustChangePassword            Boolean                @default(false) @map("must_change_password")
  /// Consecutive failed password attempts; reset to 0 on any success.
  failedLoginAttempts           Int                    @default(0) @map("failed_login_attempts")
  /// Set when `failedLoginAttempts` crosses the threshold; sign-in is refused
  /// until this passes, regardless of whether the password is correct.
  lockedUntil                   DateTime?              @map("locked_until")
  employee                      Employee?
  roleAssignments               RoleAssignment[]
  notifications                 Notification[]
  committeeRoles                CommitteeMember[]
  interviewPanels               InterviewPanelist[]
  evaluations                   Evaluation[]
  evaluationTokens              EvaluationToken[]
  unitsCreated                  Unit[]                 @relation("UnitCreatedBy")
  unitsUpdated                  Unit[]                 @relation("UnitUpdatedBy")
  departmentsCreated            Department[]           @relation("DepartmentCreatedBy")
  departmentsUpdated            Department[]           @relation("DepartmentUpdatedBy")
  positionsCreated              Position[]             @relation("PositionCreatedBy")
  positionsUpdated              Position[]             @relation("PositionUpdatedBy")
  rolesCreated                  Role[]                 @relation("RoleCreatedBy")
  rolesUpdated                  Role[]                 @relation("RoleUpdatedBy")
  roleAssignmentsGiven          RoleAssignment[]       @relation("RoleAssignedBy")
  interviewRoundsCreated        InterviewRound[]       @relation("InterviewRoundCreatedBy")
  candidatesCreated             Candidate[]            @relation("CandidateCreatedBy")
  candidatesRejected            Candidate[]            @relation("CandidateRejectedBy")
  medicalClearances             Onboarding[]           @relation("OnboardingMedicalClearedBy")
  /// Medicals this user submitted for central approval (examining officer).
  medicalSubmissions            Onboarding[]           @relation("OnboardingMedicalSubmittedBy")
  /// Medicals this user signed off centrally (Central Medical Officer).
  medicalApprovals              Onboarding[]           @relation("OnboardingMedicalApprovedBy")
  facilityReviews               Onboarding[]           @relation("OnboardingFacilitiesReviewedBy")
  offerSignatories              Onboarding[]           @relation("OnboardingOfferSignatory")
  appointmentSignatories        Onboarding[]           @relation("OnboardingAppointmentSignatory")
  boardBatchesCreated           BoardApprovalBatch[]   @relation("BoardBatchCreatedBy")
  boardBatchesAsChro            BoardApprovalBatch[]   @relation("BoardBatchChro")
  auditLogs                     AuditLog[]             @relation("AuditLogActor")
  boardGroupMemberships         BoardGroupMember[]
  boardApprovalsRequested       BoardApproval[]        @relation("BoardApprovalRequester")
  boardApprovalsHrApproved      BoardApproval[]        @relation("BoardApprovalHrApprover")
  boardApprovalsAsCorporateHr   BoardApproval[]        @relation("BoardApprovalCorporateHr")
  boardApprovalsAsChro          BoardApproval[]        @relation("BoardApprovalChro")
  interviewDelegationsHeld      InterviewDelegation[]  @relation("InterviewDelegatedTo")
  interviewDelegationsMade      InterviewDelegation[]  @relation("InterviewDelegatedBy")
  boardApprovalVotes            BoardApprovalVote[]
  referenceChecksConducted      ReferenceCheck[]       @relation("ReferenceCheckConductedBy")
  facilityNotificationsSent     FacilityNotification[] @relation("FacilityNotificationSentBy")
  facilityNotificationsReceived FacilityNotification[] @relation("FacilityNotificationRecipient")
  approvalPathsUpdated          ApprovalPath[]         @relation("ApprovalPathUpdatedBy")
  approvalPathsAsRaiser         ApprovalPath[]         @relation("ApprovalPathRaiser")
  approvalPathLevels            ApprovalPathLevel[]    @relation("ApprovalPathLevelUser")
  approvalStepsAssigned         ApprovalStep[]         @relation("ApprovalStepApprover")
  requisitionsRecruiting        Requisition[]          @relation("RequisitionRecruiter")
  requisitionRecruitersSet      Requisition[]          @relation("RequisitionRecruiterAssignedBy")
  createdAt                     DateTime               @default(now()) @map("created_at")
  updatedAt                     DateTime               @updatedAt @map("updated_at")

  @@map("users")
}

/// In-app notification, delivered live over websockets and persisted for the bell.
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(200)
  message   String
  /// Optional frontend route to open, e.g. /requisitions/:id
  link      String?   @db.VarChar(500)
  read      Boolean   @default(false)
  seenAt    DateTime? @map("seen_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Dynamic, configurable access role (e.g. Factory HR, Department Head, CHRO).
model Role {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?
  scope       RoleScope        @default(UNIT)
  /// System roles are seeded and cannot be deleted.
  isSystem    Boolean          @default(false) @map("is_system")
  assignments RoleAssignment[]
  createdById String?          @map("created_by_id")
  createdBy   User?            @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?          @map("updated_by_id")
  updatedBy   User?            @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

/// Grants a user a role, optionally scoped to a unit (null = all units / global).
model RoleAssignment {
  id           String   @id @default(cuid())
  roleId       String   @map("role_id")
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId       String?  @map("unit_id")
  unit         Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  assignedById String?  @map("assigned_by_id")
  assignedBy   User?    @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([roleId, userId, unitId])
  @@index([userId])
  @@map("role_assignments")
}

/// Organizational profile, primarily fed by the ZingHR daily sync.
model Employee {
  id              String         @id @default(cuid())
  userId          String         @unique @map("user_id")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode    String         @map("employee_code") @db.VarChar(20)
  designation     String?        @db.VarChar(150)
  department      String?        @db.VarChar(150)
  section         String?        @db.VarChar(150)
  grade           String?        @db.VarChar(50)
  category        String?        @db.VarChar(50)
  unitName        String?        @map("unit_name") @db.VarChar(200)
  unitId          String?        @map("unit_id")
  unit            Unit?          @relation(fields: [unitId], references: [id])
  location        String?        @db.VarChar(200)
  gender          String?        @db.VarChar(10)
  dateOfBirth     DateTime?      @map("date_of_birth") @db.Date
  joiningDate     DateTime?      @map("joining_date") @db.Date
  exitDate        DateTime?      @map("exit_date") @db.Date
  lineManagerName String?        @map("line_manager_name") @db.VarChar(150)
  lineManagerCode String?        @map("line_manager_code") @db.VarChar(20)
  source          EmployeeSource @default(MANUAL)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([unitId])
  @@index([department])
  @@index([unitName])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Unit configuration → drives the organogram
// ---------------------------------------------------------------------------

model Unit {
  id              String           @id @default(cuid())
  name            String           @unique @db.VarChar(200)
  isActive        Boolean          @default(true) @map("is_active")
  departments     Department[]
  positions       Position[]
  employees       Employee[]
  roleAssignments RoleAssignment[]
  approvalPaths   ApprovalPath[]
  createdById     String?          @map("created_by_id")
  createdBy       User?            @relation("UnitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?          @map("updated_by_id")
  updatedBy       User?            @relation("UnitUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("units")
}

model Department {
  id          String     @id @default(cuid())
  unitId      String     @map("unit_id")
  unit        Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name        String     @db.VarChar(150)
  positions   Position[]
  createdById String?    @map("created_by_id")
  createdBy   User?      @relation("DepartmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?    @map("updated_by_id")
  updatedBy   User?      @relation("DepartmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([unitId, name])
  @@map("departments")
}

/// A sanctioned seat in the organogram (unit + department + designation).
model Position {
  id           String       @id @default(cuid())
  unitId       String       @map("unit_id")
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  departmentId String       @map("department_id")
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designation  String       @db.VarChar(150)
  /// Optional section within the department (e.g. IT Support under IT).
  section      String?      @db.VarChar(150)
  category     SeatCategory @default(OFFICER)
  /// Job grade for this seat (e.g. "M4", "SM1", "T2") — free text, matching
  /// whatever scheme ZingHR's synced Employee.grade actually uses.
  grade        String?      @db.VarChar(20)
  sanctioned   Int          @default(0)
  /// Currently occupied seats (manually maintained). vacant = sanctioned − filled.
  filled       Int          @default(0)
  createdById  String?      @map("created_by_id")
  createdBy    User?        @relation("PositionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById  String?      @map("updated_by_id")
  updatedBy    User?        @relation("PositionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@unique([unitId, departmentId, designation])
  @@map("positions")
}

// ---------------------------------------------------------------------------
// Requisition (Phase 1)
// ---------------------------------------------------------------------------

model Requisition {
  id                    String                   @id @default(cuid())
  code                  String                   @unique @db.VarChar(20)
  designation           String                   @db.VarChar(150)
  /// Other designations this post may be filled at — "Senior Executive" raised
  /// alongside "Assistant Manager" when the level depends on who is found.
  ///
  /// `designation` stays the primary: the organogram lookup, approval routing
  /// and every existing report read it, and an empty array here means the
  /// requisition behaves exactly as a single-designation one always has. The
  /// level a candidate is actually hired at is fixed per person during
  /// onboarding — see Onboarding.fixedDesignation.
  alternateDesignations String[]                 @map("alternate_designations")
  /// Confirmed job grade for this post — one of JOB_GRADES (salary-fixation.constants.ts).
  /// Not set by the requisitioner; the current pending approver (Factory HR /
  /// SBU Head / Corporate HR, whoever's turn it is) confirms it during sign-off,
  /// informed by the organogram seat's grade + the ZingHR grade reference.
  grade                 String?                  @db.VarChar(20)
  requirementType       RequirementType          @map("requirement_type")
  requiredPosts         Int                      @map("required_posts")
  totalVacantPosts      Int                      @map("total_vacant_posts")
  unitFactory           String                   @map("unit_factory") @db.VarChar(200)
  /// DBL business vertical (Garments, Pharma, Telecom…) — fixed list in master_options.
  lineOfBusiness        String?                  @map("line_of_business") @db.VarChar(150)
  department            String                   @db.VarChar(150)
  section               String?                  @db.VarChar(150)
  /// Sub-section within the section (ZingHR vocabulary, cascades from department+section).
  subSection            String?                  @map("sub_section") @db.VarChar(150)
  placeOfPosting        String                   @map("place_of_posting") @db.VarChar(200)
  vacantDate            DateTime?                @map("vacant_date") @db.Date
  neededDate            DateTime?                @map("needed_date") @db.Date
  priority              Priority                 @default(MODERATE)
  employmentNature      EmploymentNature         @default(PERMANENT) @map("employment_nature")
  contractualPurpose    String?                  @map("contractual_purpose")
  /// Replacement details — required when requirementType is EXISTING (Replace),
  /// null on a NEW headcount. `replaceOfName` is a snapshot: the person may
  /// have already left by the time anyone reads it.
  ///
  /// These four hold the FIRST replaced employee only. A requisition can now
  /// replace several people at once (three leavers, one requisition), and the
  /// full list lives in `replacements`. They are kept, and kept in step with
  /// replacements[0], because the approval sheet, the board export and several
  /// reports read them directly — changing those is a separate job from
  /// letting the form take more than one name.
  replaceOfName         String?                  @map("replace_of_name") @db.VarChar(150)
  replaceOfEmployeeCode String?                  @map("replace_of_employee_code") @db.VarChar(50)
  separationReason      String?                  @map("separation_reason")
  replacementRemarks    String?                  @map("replacement_remarks")
  jobDescription        String                   @map("job_description")
  education             String
  experience            String
  others                String?
  /// Requisitioner's requests (Laptop/Desktop, Transport, Dormitory, Seating)
  /// + each facility's HR confirm/skip decision — see FacilityDecision on the frontend.
  /// Everyone this requisition replaces. Empty on a NEW headcount.
  replacements          RequisitionReplacement[]
  facilities            Json?
  preferredSources      String[]                 @map("preferred_sources")
  status                RequisitionStatus        @default(PENDING_APPROVAL)
  roleProfile           Json?                    @map("role_profile")
  posting               Json?
  /// Corporate HR committee deliberation / final recommendation notes.
  deliberationNotes     String?                  @map("deliberation_notes")
  raisedBy              String?                  @map("raised_by") @db.VarChar(150)
  raisedById            String?                  @map("raised_by_id")
  /// Corporate Recruiter who owns this requisition's post-approval lifecycle
  /// (candidates → assessment → salary → onboarding). Nominated by Corporate
  /// HR once approved. Additive: Corporate HR / CHRO keep their access.
  recruiterId           String?                  @map("recruiter_id")
  recruiter             User?                    @relation("RequisitionRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  recruiterAssignedAt   DateTime?                @map("recruiter_assigned_at")
  recruiterAssignedById String?                  @map("recruiter_assigned_by_id")
  recruiterAssignedBy   User?                    @relation("RequisitionRecruiterAssignedBy", fields: [recruiterAssignedById], references: [id], onDelete: SetNull)
  /// Phase 2: Google Drive folder ids + shareable links for this requisition's recruitment workspace.
  drive                 Json?
  /// Optional supporting files (JD, approvals, etc.) — array of { name, fileId, url, size, uploadedAt }.
  attachments           Json?
  approvalSteps         ApprovalStep[]
  activities            RequisitionActivity[]
  candidates            Candidate[]
  committeeMembers      CommitteeMember[]
  interviewRounds       InterviewRound[]
  interviewDelegations  InterviewDelegation[]
  bdJobsPost            BdJobsPost?
  talentBankMatches     TalentBankMatch[]
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  /// Soft delete — null means active; set to timestamp when "deleted".
  deletedAt             DateTime?                @map("deleted_at")

  @@index([status])
  @@index([unitFactory])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([recruiterId])
  @@map("requisitions")
}

/// BDJobs job posting record — one per requisition.
model BdJobsPost {
  id            String      @id @default(cuid())
  requisitionId String      @unique @map("requisition_id")
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  /// BDJobs assigned job ID (null until successfully posted)
  bdJobsJobId   String?     @map("bdjobs_job_id") @db.VarChar(50)
  /// draft | posted | failed
  status        String      @default("draft") @db.VarChar(20)
  /// All form fields submitted by Corporate HR
  formData      Json        @map("form_data")
  errorMessage  String?     @map("error_message")
  postedAt      DateTime?   @map("posted_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("bdjobs_posts")
}

/// A CV / applicant against a requisition (Phase 2 — CV collection).
model Candidate {
  id                    String                 @id @default(cuid())
  requisitionId         String                 @map("requisition_id")
  requisition           Requisition            @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  name                  String                 @db.VarChar(150)
  email                 String?                @db.VarChar(254)
  phone                 String?                @db.VarChar(40)
  source                CandidateSource        @default(manual)
  stage                 CandidateStage         @default(APPLIED)
  /// Google Drive file id + view link for the CV document.
  cvFileId              String?                @map("cv_file_id") @db.VarChar(100)
  cvUrl                 String?                @map("cv_url")
  /// The CV as structured data in the system's common format (`CvProfile`),
  /// when the source sent one instead of — or as well as — a document.
  cvProfile             Json?                  @map("cv_profile")
  cvProfileAt           DateTime?              @map("cv_profile_at")
  /// Postal address the AI read off the CV — prefills the offer letter.
  cvAddress             String?                @map("cv_address") @db.VarChar(300)
  notes                 String?
  /// What they are on now, and what they are asking for.
  ///
  /// Both are taken in the interview room, by whoever runs the session —
  /// usually factory HR on the first interview. They are facts about the
  /// candidate rather than about one round, so they live here and not on
  /// InterviewRound: asking again at the second interview would get the same
  /// two numbers, and storing them twice invites them to disagree.
  presentSalary         Float?                 @map("present_salary")
  salaryExpectation     Float?                 @map("salary_expectation")
  /// Allowances, transport, accommodation, bonuses — whatever the candidate
  /// says their current package includes beyond the cash figure. Free text on
  /// purpose: it is what they told the interviewer, not a structured claim.
  salaryBenefitsNote    String?                @map("salary_benefits_note")
  /// AI CV-screening: match score 0-100 against the role + a short rationale.
  matchScore            Float?                 @map("match_score")
  matchSummary          String?                @map("match_summary")
  matchDetails          Json?                  @map("match_details")
  screenedAt            DateTime?              @map("screened_at")
  viewedAt              DateTime?              @map("viewed_at")
  /// Phase 3: suitable-but-not-selected candidates kept for future recall.
  talentPool            Boolean                @default(false) @map("talent_pool")
  /// Red flag: set by Corp HR / CHRO when this candidate is barred from future roles.
  isRedFlagged          Boolean                @default(false) @map("is_red_flagged")
  redFlagReason         String?                @map("red_flag_reason")
  redFlaggedAt          DateTime?              @map("red_flagged_at")
  redFlaggedById        String?                @map("red_flagged_by_id")
  /// Rejection record. `rejectionStage` says where it happened — notably
  /// 'first_interview', which is a factory-side interviewer's call, as opposed
  /// to a CV screening rejection by Corporate HR.
  rejectedAt            DateTime?              @map("rejected_at")
  rejectedById          String?                @map("rejected_by_id")
  rejectedBy            User?                  @relation("CandidateRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectionStage        String?                @map("rejection_stage") @db.VarChar(30)
  rejectionReason       String?                @map("rejection_reason")
  createdById           String?                @map("created_by_id")
  createdBy             User?                  @relation("CandidateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Bdjobs inbound: unique per Bdjobs application — used for deduplication.
  /// The DBL employee ID, assigned by the recruiter once the hire is settled.
  /// It is the number the Code of Conduct and the personnel file are filed
  /// under, so it lives on the candidate rather than in one form's fields.
  employeeId            String?                @map("employee_id") @db.VarChar(30)
  /// Who this hire reports to, chosen from the synced employee directory when
  /// the placement is settled. Stored as a name + code snapshot rather than a
  /// relation, exactly like Employee.lineManager*: the directory is ZingHR's
  /// and a manager can leave without this record of the placement changing.
  lineManagerName       String?                @map("line_manager_name") @db.VarChar(150)
  lineManagerCode       String?                @map("line_manager_code") @db.VarChar(20)
  lineManagerTitle      String?                @map("line_manager_title") @db.VarChar(150)
  bdjobsApplicationId   String?                @unique @map("bdjobs_application_id") @db.VarChar(100)
  /// Bdjobs inbound: the applicant's Bdjobs profile ID.
  bdjobsApplicantId     String?                @map("bdjobs_applicant_id") @db.VarChar(100)
  /// Bdjobs inbound: the Bdjobs job listing ID this candidate applied to.
  bdjobsJobId           String?                @map("bdjobs_job_id") @db.VarChar(100)
  interviews            InterviewRound[]
  interviewDelegations  InterviewDelegation[]
  onboarding            Onboarding?
  boardApprovals        BoardApproval[]
  salaryFixation        SalaryFixation?
  aiProficiencyAttempts AiProficiencyAttempt[]
  facilityNotifications FacilityNotification[]
  referenceChecks       ReferenceCheck[]
  talentBankMatches     TalentBankMatch[]
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  /// Soft delete — null means active; set to timestamp when "deleted".
  deletedAt             DateTime?              @map("deleted_at")

  @@index([requisitionId, stage])
  @@index([stage])
  @@index([rejectionStage])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("candidates")
}

/// AI-computed suggestion: a Talent Bank candidate matched against one open
/// requisition's role. Recomputed automatically (approval/post events, a
/// daily backstop cron, or a manual rescan) — rows are fully replaced per
/// requisition on each sync, so this table always reflects the latest run.
model TalentBankMatch {
  id            String      @id @default(cuid())
  requisitionId String      @map("requisition_id")
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  candidateId   String      @map("candidate_id")
  candidate     Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  relevance     Int
  reason        String
  computedAt    DateTime    @default(now()) @map("computed_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([requisitionId, candidateId])
  @@index([requisitionId])
  @@index([candidateId])
  @@map("talent_bank_matches")
}

enum SalaryFixationStatus {
  draft
  screening_failed
  fixed
}

/// Phase 4 — post-interview salary fixation: screening-test gate, committee
/// scoring across 10 fixed weighted criteria, and the resulting salary band
/// + proposed gross salary for the candidate's job grade.
model SalaryFixation {
  id          String    @id @default(cuid())
  candidateId String    @unique @map("candidate_id")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  /// One of JOB_GRADES (salary-fixation.constants.ts) — defaults from the
  /// requisition's confirmed grade the first time this record is opened,
  /// editable by HR after that.
  jobGrade String? @map("job_grade") @db.VarChar(10)

  // Pre-interview screening tests (each gated at its own pass mark, default 50%).
  writtenTestEnabled   Boolean @default(false) @map("written_test_enabled")
  writtenTestTotal     Float?  @map("written_test_total")
  writtenTestObtained  Float?  @map("written_test_obtained")
  /// The marked answer script, scanned and attached — optional, and filed with
  /// the requisition's interview documents. A mark on its own is somebody's
  /// word for it; this is what Corporate HR can actually look at.
  writtenTestSheetId   String? @map("written_test_sheet_id")
  writtenTestSheetUrl  String? @map("written_test_sheet_url")
  /// Computer Literacy — hand-marked like the Written Test, off unless enabled.
  computerTestEnabled  Boolean @default(false) @map("computer_test_enabled")
  computerTestTotal    Float?  @map("computer_test_total")
  computerTestObtained Float?  @map("computer_test_obtained")
  computerTestSheetId  String? @map("computer_test_sheet_id")
  computerTestSheetUrl String? @map("computer_test_sheet_url")
  /// HR can skip Step 2 per candidate; defaults on since it was mandatory-only before this field existed.
  aiTestEnabled        Boolean @default(true) @map("ai_test_enabled")
  aiTestTotal          Float?  @map("ai_test_total")
  aiTestObtained       Float?  @map("ai_test_obtained")

  // Committee scoring lives on Evaluation.salaryScores/salaryTotal — panelists
  // mark it themselves from their own interview-evaluation link. Nothing to
  // store here; averageScore/computedBand/proposedSalary below are computed
  // live from those Evaluation rows (and snapshotted at finalize time).

  // Derived — recomputed server-side on every save, never client-supplied.
  averageScore           Float? @map("average_score")
  computedBand           Int?   @map("computed_band")
  /// HR manual override of the computed band, per policy's "Management reserves the right to deviation".
  bandOverride           Int?   @map("band_override")
  proposedSalary         Float? @map("proposed_salary")
  /// HR manual override of the auto-computed proposed salary — takes precedence when set.
  proposedSalaryOverride Float? @map("proposed_salary_override")

  status SalaryFixationStatus @default(draft)

  /// A figure was formally communicated to the candidate — lighter-weight
  /// than finalize(), doesn't require full committee scoring to be done.
  offeredAt   DateTime? @map("offered_at")
  offeredById String?   @map("offered_by_id")

  finalizedAt   DateTime? @map("finalized_at")
  finalizedById String?   @map("finalized_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("salary_fixations")
}

/// Registry of red-flagged identities (email + phone) for auto-flagging future applications.
model RedFlagRegistry {
  id          String   @id @default(cuid())
  /// Normalised lowercase email (may be null if only phone was known).
  email       String?  @unique @db.VarChar(254)
  /// Phone digits only (may be null if only email was known).
  phone       String?  @unique @db.VarChar(40)
  reason      String
  flaggedById String   @map("flagged_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([phone])
  @@map("red_flag_registry")
}

/// Phase 3 — a scheduled interview round for a candidate (first / second / final).
model InterviewRound {
  id               String              @id @default(cuid())
  candidateId      String              @map("candidate_id")
  candidate        Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requisitionId    String              @map("requisition_id")
  requisition      Requisition         @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  kind             InterviewKind       @default(FIRST)
  mode             InterviewMode       @default(PHYSICAL)
  scheduledAt      DateTime?           @map("scheduled_at")
  /// Venue (physical) or meeting link (online).
  location         String?             @db.VarChar(500)
  status           InterviewStatus     @default(SCHEDULED)
  /// Google Calendar sync: event id + the auto-generated Meet link (online).
  calendarEventId  String?             @map("calendar_event_id") @db.VarChar(200)
  meetLink         String?             @map("meet_link")
  panelists        InterviewPanelist[]
  evaluations      Evaluation[]
  evaluationTokens EvaluationToken[]
  createdById      String?             @map("created_by_id")
  createdBy        User?               @relation("InterviewRoundCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now()) @map("created_at")

  @@index([candidateId])
  @@index([requisitionId])
  @@map("interview_rounds")
}

/// Phase 3 — a shortlisted candidate handed to factory / unit staff so they can
/// run the first interview themselves.
///
/// Scoped deliberately narrowly: holding a delegation grants rights over that
/// one candidate — schedule the round, form the committee, read the marks —
/// and nothing else in the unit.
model InterviewDelegation {
  id            String      @id @default(cuid())
  candidateId   String      @map("candidate_id")
  candidate     Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requisitionId String      @map("requisition_id")
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  delegatedToId String      @map("delegated_to_id")
  delegatedTo   User        @relation("InterviewDelegatedTo", fields: [delegatedToId], references: [id], onDelete: Cascade)
  delegatedById String?     @map("delegated_by_id")
  delegatedBy   User?       @relation("InterviewDelegatedBy", fields: [delegatedById], references: [id], onDelete: SetNull)
  note          String?
  /// How many times this candidate has been handed to this person.
  ///
  /// The row is upserted, so a re-send used to be invisible: the note changed
  /// and `createdAt` stayed at the original hand-off. HR could chase the same
  /// interviewer three times with no record that they had. 1 on the first
  /// send; anything above that is a nudge somebody should be able to see.
  sendCount     Int         @default(1) @map("send_count")
  /// When it was last sent. `createdAt` remains the FIRST hand-off, so the two
  /// together say "assigned on the 3rd, chased again on the 11th".
  lastSentAt    DateTime    @default(now()) @map("last_sent_at")
  /// Set instead of deleting, so an audit of who could act survives.
  revokedAt     DateTime?   @map("revoked_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([candidateId, delegatedToId])
  @@index([delegatedToId, revokedAt])
  @@index([requisitionId])
  @@map("interview_delegations")
}

/// Phase 3 — a committee member assigned to an interview round's panel.
model InterviewPanelist {
  id      String         @id @default(cuid())
  roundId String         @map("round_id")
  round   InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId  String         @map("user_id")
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([userId])
  @@map("interview_panelists")
}

/// Phase 3 — a one-click secure evaluation link sent to each panelist (no login required).
model EvaluationToken {
  id             String          @id @default(cuid())
  /// Legacy raw token. Null on every token issued since hashing was
  /// introduced — the raw value now lives only in the emailed link.
  token          String?         @unique @db.VarChar(64)
  /// SHA-256 of the raw token. What lookups actually match on.
  tokenHash      String?         @unique @map("token_hash") @db.VarChar(64)
  roundId        String          @map("round_id")
  round          InterviewRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  panelistUserId String          @map("panelist_user_id")
  panelistUser   User            @relation(fields: [panelistUserId], references: [id], onDelete: Cascade)
  status         EvalTokenStatus @default(sent)
  openedAt       DateTime?       @map("opened_at")
  submittedAt    DateTime?       @map("submitted_at")
  /// 48h after the interview date, or 7 days from creation when no scheduledAt.
  expiresAt      DateTime        @map("expires_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@unique([roundId, panelistUserId])
  @@index([roundId])
  @@map("evaluation_tokens")
}

/// Global bank of AI Proficiency screening questions (up to ~500), tagged by
/// which job grade(s) they apply to — not scoped to a requisition.
model AiProficiencyQuestion {
  id        String   @id @default(cuid())
  prompt    String
  /// MCQ options, e.g. ["A", "B", "C", "D"]
  options   Json
  /// The correct option text.
  answer    String
  marks     Int      @default(1)
  /// Applicable JobGrade codes, e.g. ["M3", "M4"].
  grades    String[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([grades])
  @@map("ai_proficiency_questions")
}

/// A candidate's AI Proficiency screening attempt — one per candidate, a
/// frozen random subset of AiProficiencyQuestion chosen at assignment time,
/// token-linked (no login), auto-graded on submit.
model AiProficiencyAttempt {
  id                String    @id @default(cuid())
  candidateId       String    @map("candidate_id")
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// Legacy raw token; null for anything issued since hashing was introduced.
  token             String?   @unique @db.VarChar(64)
  /// SHA-256 of the raw token — what lookups match on.
  tokenHash         String?   @unique @map("token_hash") @db.VarChar(64)
  jobGrade          String    @map("job_grade") @db.VarChar(10)
  /// Frozen shuffled subset of AiProficiencyQuestion ids, in display order.
  questionIds       String[]  @map("question_ids")
  /// { questionId: selectedOption }
  answers           Json?
  totalScore        Float?    @map("total_score")
  maxScore          Float     @map("max_score")
  /// pending | submitted
  status            String    @default("pending") @db.VarChar(20)
  /// Minutes the candidate gets once they open the test; null = no limit.
  timeLimitMinutes  Int?      @map("time_limit_minutes")
  /// Stamped the first time the candidate opens the test — the countdown
  /// runs from here, not from assignment, so an unopened link doesn't burn time.
  startedAt         DateTime? @map("started_at")
  /// Focus-lock log — array of { leftAt, returnedAt, endedTest }, one entry
  /// per time the candidate left the test tab/window or exited fullscreen.
  violations        Json?
  /// Why the attempt ended: candidate | time_up | violation. Null while pending.
  terminationReason String?   @map("termination_reason") @db.VarChar(20)
  submittedAt       DateTime? @map("submitted_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([candidateId])
  @@map("ai_proficiency_attempts")
}

/// Phase 4 & 5 — document collection, verification, offer & onboarding for a
/// selected candidate. One per candidate.
model Onboarding {
  id                    String           @id @default(cuid())
  candidateId           String           @unique @map("candidate_id")
  candidate             Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// Legacy raw token; null for anything issued since hashing was introduced.
  token                 String?          @unique @db.VarChar(64)
  /// SHA-256 of the raw token — what lookups match on.
  tokenHash             String?          @unique @map("token_hash") @db.VarChar(64)
  status                OnboardingStatus @default(docs_pending)
  /// HR can skip waiting for the candidate to submit documents.
  docsSkippedAt         DateTime?        @map("docs_skipped_at")
  /// HR can skip individually verifying every submitted document.
  verificationSkippedAt DateTime?        @map("verification_skipped_at")
  offerSentAt           DateTime?        @map("offer_sent_at")
  offerAcceptedAt       DateTime?        @map("offer_accepted_at")
  /// Acknowledgement of the Company Code of Conduct — sent to the candidate,
  /// signed by them on their own portal with an uploaded e-signature. The
  /// completed form is filed with their joining documents on Drive, so these
  /// hold only when it went and where it landed.
  cocSentAt             DateTime?        @map("coc_sent_at")
  cocSignedAt           DateTime?        @map("coc_signed_at")
  cocFileId             String?          @map("coc_file_id")
  cocUrl                String?          @map("coc_url")
  /// What the candidate told us when they accepted: the date they expect to
  /// join, and the copy they signed by hand. Both are theirs to give, so they
  /// sit beside offerAcceptedAt rather than on the letter's own fields.
  offerJoiningTentative DateTime?        @map("offer_joining_tentative")
  offerSignedFileId     String?          @map("offer_signed_file_id")
  offerSignedUrl        String?          @map("offer_signed_url")
  /// The candidate turned the offer down. Kept as its own timestamp rather
  /// than an OnboardingStatus value so every existing `offerAcceptedAt IS NOT
  /// NULL` gate keeps its exact meaning, and a row can never read as both.
  offerDeclinedAt       DateTime?        @map("offer_declined_at")
  /// Why they declined — required from them, and the only thing HR has to go
  /// on when deciding whether to improve the offer or move to the next
  /// candidate. Cleared if HR sends a fresh offer.
  offerDeclineReason    String?          @map("offer_decline_reason")
  medicalStatus         MedicalStatus    @default(pending) @map("medical_status")
  medicalNote           String?          @map("medical_note")
  medicalClearedAt      DateTime?        @map("medical_cleared_at")
  // --- Offer & appointment letters -------------------------------------
  /// 'junior' (probation + notice) or 'senior' (job location + benefits) —
  /// DBL issues two house formats and HR picks one per candidate.
  /// Which of the requisition's designations this person is actually hired at.
  ///
  /// A requisition may offer several levels ("Senior Executive" or "Assistant
  /// Manager") because the level depends on who is found. This is where that is
  /// settled, per candidate, and it is what the offer and appointment letters
  /// print. Null means the requisition's primary designation, which is every
  /// single-designation requisition.
  fixedDesignation      String?          @map("fixed_designation") @db.VarChar(150)
  offerFormat           String?          @map("offer_format") @db.VarChar(10)
  offerRef              String?          @map("offer_ref") @db.VarChar(60)
  /// "effective on or before" — the date printed on the letter.
  offerJoiningDate      DateTime?        @map("offer_joining_date") @db.Date
  offerJobLocation      String?          @map("offer_job_location") @db.VarChar(200)
  offerProbationMonths  Int?             @map("offer_probation_months")
  offerNoticeDays       Int?             @map("offer_notice_days")
  offerBenefits         String[]         @map("offer_benefits")
  /// The letter exactly as it was sent. A candidate holds a copy, so it must
  /// not change afterwards because a template or a salary did.
  offerLetterHtml       String?          @map("offer_letter_html")
  /// The CHRO the letter goes out over. Chosen per letter rather than looked
  /// up, because the group has had more than one holder of the role and a
  /// letter must name the person who actually signed it. Their e-signature is
  /// baked into offerLetterHtml at send time, so this is the record of who
  /// was picked, not where the image came from.
  offerSignatoryId      String?          @map("offer_signatory_id")
  offerSignatory        User?            @relation("OnboardingOfferSignatory", fields: [offerSignatoryId], references: [id], onDelete: SetNull)
  appointmentSignatoryId String?         @map("appointment_signatory_id")
  appointmentSignatory  User?            @relation("OnboardingAppointmentSignatory", fields: [appointmentSignatoryId], references: [id], onDelete: SetNull)
  /// The offer as the candidate accepted it: the letter they were sent, with
  /// their own e-signature and joining date filled into the acceptance box,
  /// rendered at the moment they accept and filed with their joining docs.
  /// Distinct from offerSigned*, which is a scan they post back by hand —
  /// either, both or neither can exist.
  offerAcceptedFileId   String?          @map("offer_accepted_file_id")
  offerAcceptedUrl      String?          @map("offer_accepted_url")
  candidateAddress      String?          @map("candidate_address") @db.VarChar(300)
  appointmentRef        String?          @map("appointment_ref") @db.VarChar(60)
  appointmentSentAt     DateTime?        @map("appointment_sent_at")
  appointmentLetterHtml String?          @map("appointment_letter_html")

  /// Recorded from a paper/offline check rather than the structured form, so
  /// the completeness gate on MedicalExam was deliberately bypassed.
  medicalManual                Boolean         @default(false) @map("medical_manual")
  /// The pre-employment medical test letter — reference, appointment and venue.
  ///
  /// The reference continues DBL's existing DBL/Corp/HR/MT-<serial>/<yy>
  /// register, issued from a database sequence so two letters can never share
  /// one. Stored so a re-send repeats the number rather than burning a new one.
  medicalRefNo                 String?         @map("medical_ref_no") @db.VarChar(40)
  /// Date AND time of the appointment — "10:30 AM" is on the letter.
  medicalExamAt                DateTime?       @map("medical_exam_at")
  medicalVenue                 String?         @map("medical_venue")
  /// Which test list was used. Null until a letter is sent.
  medicalAgeBand               String?         @map("medical_age_band") @db.VarChar(10)
  medicalLetterSentAt          DateTime?       @map("medical_letter_sent_at")
  /// Tracked separately because they are two sends and either can fail alone.
  /// One stamp could not answer "was the candidate actually told?", which is
  /// the question asked when somebody does not turn up for their exam.
  medicalLetterTeamSentAt      DateTime?       @map("medical_letter_team_sent_at")
  medicalLetterCandidateSentAt DateTime?       @map("medical_letter_candidate_sent_at")
  /// When the medical team was told this candidate is waiting on them, so the
  /// alert fires once rather than on every document verified.
  medicalNotifiedAt            DateTime?       @map("medical_notified_at")
  /// What the examining officer submitted for approval — `cleared` or
  /// `rejected`. Kept separately from `medicalStatus` so the Central Medical
  /// Officer can see what they are being asked to confirm while the candidate's
  /// actual state is still `submitted`.
  medicalProposed              MedicalStatus?  @map("medical_proposed")
  medicalSubmittedAt           DateTime?       @map("medical_submitted_at")
  medicalSubmittedById         String?         @map("medical_submitted_by_id")
  medicalSubmittedBy           User?           @relation("OnboardingMedicalSubmittedBy", fields: [medicalSubmittedById], references: [id], onDelete: SetNull)
  /// Who signed it off centrally, and when. Null on a result HR recorded by
  /// hand, which is deliberately immediate and therefore never CMO-approved —
  /// the distinction is shown wherever the clearance is displayed.
  medicalApprovedAt            DateTime?       @map("medical_approved_at")
  medicalApprovedById          String?         @map("medical_approved_by_id")
  medicalApprovedBy            User?           @relation("OnboardingMedicalApprovedBy", fields: [medicalApprovedById], references: [id], onDelete: SetNull)
  /// The Central Medical Officer's note — required when overturning or
  /// returning a submission, because those reverse a clinician's finding.
  medicalCmoNote               String?         @map("medical_cmo_note")
  medicalClearedById           String?         @map("medical_cleared_by_id")
  medicalClearedBy             User?           @relation("OnboardingMedicalClearedBy", fields: [medicalClearedById], references: [id], onDelete: SetNull)
  /// HR has looked at what this hire is entitled to — car, accommodation,
  /// SIM, laptop — and said so.
  ///
  /// A deliberate stop rather than something derived. A candidate entitled to
  /// nothing used to fall straight from document verification into medical
  /// with the facility step never opened, which is exactly the case where
  /// somebody should have confirmed there is genuinely nothing to arrange.
  /// Medical is gated on this (see MEDICAL_DUE), so it cannot be skipped by
  /// being empty.
  facilitiesReviewedAt         DateTime?       @map("facilities_reviewed_at")
  facilitiesReviewedById       String?         @map("facilities_reviewed_by_id")
  facilitiesReviewedBy         User?           @relation("OnboardingFacilitiesReviewedBy", fields: [facilitiesReviewedById], references: [id], onDelete: SetNull)
  /// The lab prints, handed over on paper. The soft copy is uploaded like
  /// any other document; this is HR ticking off that the physical set
  /// arrived, which no upload can evidence.
  photosHardCopyAt             DateTime?       @map("photos_hard_copy_at")
  /// The candidate's particulars exactly as printed on their NID, typed by
  /// them next to the scan.
  ///
  /// Typed rather than read off the image: these four go onto the
  /// appointment letter and the payroll record, and an OCR misread of a
  /// Bengali name or a digit of the NID number is not something anybody
  /// catches by looking at a thumbnail.
  nidName                      String?         @map("nid_name") @db.VarChar(150)
  nidAddress                   String?         @map("nid_address")
  nidDob                       DateTime?       @map("nid_dob") @db.Date
  nidNumber                    String?         @map("nid_number") @db.VarChar(40)
  hrVerifiedAt                 DateTime?       @map("hr_verified_at")
  /// AI cross-verification of submitted docs vs the candidate's profile:
  /// { verdict, overview, findings: [{doc, severity, detail}] }
  crossCheck                   Json?           @map("cross_check")
  crossCheckedAt               DateTime?       @map("cross_checked_at")
  archivedAt                   DateTime?       @map("archived_at")
  /// Drive folder the joining docs were moved into on archive.
  archiveFolderUrl             String?         @map("archive_folder_url")
  itEmail                      String?         @map("it_email") @db.VarChar(254)
  itAssetId                    String?         @map("it_asset_id") @db.VarChar(50)
  itNotifiedAt                 DateTime?       @map("it_notified_at")
  docs                         OnboardingDoc[]
  medicalExam                  MedicalExam?
  createdAt                    DateTime        @default(now()) @map("created_at")
  updatedAt                    DateTime        @updatedAt @map("updated_at")

  @@map("onboardings")
}

/// Structured Medical Fitness Report — one per onboarding, filled in by the
/// medical officer alongside (or instead of) an uploaded signed copy
/// (stored as an OnboardingDoc). Mirrors DBL's own paper "Medical Fitness
/// Report" letterhead field-for-field. All columns are nullable so the
/// officer can save partial progress — completeness is only enforced by
/// OnboardingService.setMedical() at the moment of clearing.
model MedicalExam {
  id           String     @id @default(cuid())
  onboardingId String     @unique @map("onboarding_id")
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  /// Often left blank on the paper form itself — kept optional.
  dutyPosition   String?   @map("duty_position")
  refNo          String?   @map("ref_no")
  registrationNo String?   @map("registration_no")
  examDate       DateTime? @map("exam_date") @db.Date
  issueDate      DateTime? @map("issue_date") @db.Date
  consultantName String?   @map("consultant_name")

  height        String?
  weight        String?
  pulse         String?
  bloodPressure String? @map("blood_pressure")

  visionRightEye  String?  @map("vision_right_eye")
  visionLeftEye   String?  @map("vision_left_eye")
  /// true = "with glass", false = "without glass".
  visionWithGlass Boolean? @map("vision_with_glass")

  colorVisionYellow String? @map("color_vision_yellow")
  colorVisionRed    String? @map("color_vision_red")
  colorVisionGreen  String? @map("color_vision_green")
  colorVisionBlue   String? @map("color_vision_blue")

  hearingRightEar String? @map("hearing_right_ear")
  hearingLeftEar  String? @map("hearing_left_ear")
  speech          String?
  extremities     String?

  noAnemiaJaundiceEtc           Boolean? @map("no_anemia_jaundice_etc")
  stableNormotensiveNondiabetic Boolean? @map("stable_normotensive_nondiabetic")
  urineTestClear                Boolean? @map("urine_test_clear")
  hepatitisBNegative            Boolean? @map("hepatitis_b_negative")
  liverFunctionNormal           Boolean? @map("liver_function_normal")
  pastIllnessHistory            String?  @map("past_illness_history")
  familyHistoryDmHtn            Boolean? @map("family_history_dm_htn")
  familyHistoryDetail           String?  @map("family_history_detail")

  bloodGroup String?  @map("blood_group")
  /// The doctor's overall determination — drives whether clearance is valid.
  fitToJoin  Boolean? @map("fit_to_join")
  remarks    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("medical_exams")
}

/// A document the candidate submitted (stored on Drive), with AI extraction.
model OnboardingDoc {
  id           String              @id @default(cuid())
  onboardingId String              @map("onboarding_id")
  onboarding   Onboarding          @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  /// Which slot on the checklist this fills — 'ssc_certificate',
  /// 'professional_cert', and so on (see JOINING_DOCS).
  ///
  /// Matching used to be on `label`, which meant rewording a checklist item
  /// orphaned every document already filed under the old words. The key is
  /// stable and never shown; the label is what people read, and for the
  /// repeatable slots it is the name the candidate typed ("PMP", "Six
  /// Sigma Green Belt"), so several rows can share one key.
  docKey       String?             @map("doc_key") @db.VarChar(60)
  label        String              @db.VarChar(150)
  fileId       String              @map("file_id") @db.VarChar(100)
  url          String
  mimeType     String              @map("mime_type") @db.VarChar(100)
  status       OnboardingDocStatus @default(pending)
  /// AI (OCR + LLM) extracted structured fields.
  aiExtract    Json?               @map("ai_extract")
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([onboardingId])
  @@index([onboardingId, docKey])
  @@map("onboarding_docs")
}

/// Phase 3 — one panelist's scores + comments for a candidate in a round.
/// Scored against the fixed 10-criteria set (see salary-fixation.constants.ts)
/// — the same criteria feed both the hiring scorecard and salary fixation.
model Evaluation {
  id          String         @id @default(cuid())
  roundId     String         @map("round_id")
  round       InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  evaluatorId String         @map("evaluator_id")
  evaluator   User           @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  /// { criterionKey: score, ... }
  scores      Json
  comments    String?
  total       Float          @default(0)
  submittedAt DateTime       @default(now()) @map("submitted_at")

  @@unique([roundId, evaluatorId])
  @@map("evaluations")
}

/// Phase 3 — a member of a requisition's interview committee (a synced user who
/// logs in to mark candidates).
model CommitteeMember {
  id            String      @id @default(cuid())
  requisitionId String      @map("requisition_id")
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// interviewer | evaluator
  role          String      @default("interviewer") @db.VarChar(20)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([requisitionId, userId])
  @@index([userId])
  @@map("committee_members")
}

/// Phase 3 — a component of a requisition's assessment plan (written/excel/skill/viva).
/// One person a requisition replaces.
///
/// A single requisition often covers several leavers — three operators gone in
/// the same month, one requisition to refill the line. Each is recorded
/// separately because they rarely leave on the same date or for the same
/// reason, and an approver signing the sheet needs to see the real picture
/// rather than one name standing in for three.
model RequisitionReplacement {
  id            String      @id @default(cuid())
  requisitionId String      @map("requisition_id")
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  /// Snapshot, not a foreign key: the person has usually already left, and a
  /// requisition raised in 2026 must still read correctly after their employee
  /// record is archived or their name is corrected.
  employeeName String  @map("employee_name") @db.VarChar(150)
  employeeCode String? @map("employee_code") @db.VarChar(50)

  /// Resigned / Terminated / Retired / Transferred / Deceased — per person.
  separationReason String?   @map("separation_reason") @db.VarChar(120)
  /// When their seat actually became free.
  vacantDate       DateTime? @map("vacant_date") @db.Date
  remarks          String?

  /// Display order, so the list reads the way the raiser entered it.
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([requisitionId])
  @@map("requisition_replacements")
}

model ApprovalStep {
  id             String        @id @default(cuid())
  requisitionId  String        @map("requisition_id")
  requisition    Requisition   @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  orderIndex     Int           @map("order_index")
  /// Set only on role-routed steps — legacy chains raised before configurable
  /// approval paths, and the CHRO step appended on escalation. Person-routed
  /// steps (the norm now) carry `approverUserId` instead.
  role           ApprovalRole?
  /// The named approver, snapshotted from the unit's ApprovalPath at creation
  /// time so editing a unit's path never reroutes an in-flight requisition.
  approverUserId String?       @map("approver_user_id")
  approverUser   User?         @relation("ApprovalStepApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  title          String        @db.VarChar(150)
  subtitle       String        @db.VarChar(200)
  assignee       String        @default("") @db.VarChar(150)
  status         StepStatus    @default(PENDING)
  note           String        @default("")
  actedAt        DateTime?     @map("acted_at")

  @@unique([requisitionId, orderIndex])
  @@index([approverUserId])
  @@map("approval_steps")
}

// ---------------------------------------------------------------------------
// Configurable approval paths — per-unit, level-wise, named approvers.
// Configured by Corporate HR / CHRO / super users.
// ---------------------------------------------------------------------------

/// A configurable sign-off path, one per (unit, requisition raiser).
///
/// Corporate HR nominates the raisers for a unit — there can be several — and
/// gives each their own chain, so two people raising in the same unit can route
/// to different approvers. `levels` holds only the *intermediate* approvers:
/// a Corporate HR step is always appended automatically at raise time, so a
/// path with zero levels legitimately means "straight to Corporate HR".
model ApprovalPath {
  id          String              @id @default(cuid())
  unitId      String              @map("unit_id")
  unit        Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  /// The Requisition Raiser whose requisitions follow this chain.
  raiserId    String              @map("raiser_id")
  raiser      User                @relation("ApprovalPathRaiser", fields: [raiserId], references: [id], onDelete: Cascade)
  /// Department this chain covers. '' means "any department in this unit" —
  /// the fallback used when no department-specific chain exists.
  department  String              @default("") @db.VarChar(150)
  levels      ApprovalPathLevel[]
  updatedById String?             @map("updated_by_id")
  updatedBy   User?               @relation("ApprovalPathUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([unitId, raiserId, department])
  @@index([unitId])
  @@index([raiserId])
  @@index([unitId, department])
  @@map("approval_paths")
}

/// A single level in a unit's approval path — an ordered, named approver.
model ApprovalPathLevel {
  id         String       @id @default(cuid())
  pathId     String       @map("path_id")
  path       ApprovalPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  orderIndex Int          @map("order_index")
  userId     String       @map("user_id")
  user       User         @relation("ApprovalPathLevelUser", fields: [userId], references: [id], onDelete: Restrict)
  /// Display label for the level, e.g. "Factory HR" / "Unit Head".
  title      String       @db.VarChar(150)
  subtitle   String       @default("") @db.VarChar(200)

  @@unique([pathId, orderIndex])
  @@index([userId])
  @@map("approval_path_levels")
}

model RequisitionActivity {
  id            String           @id @default(cuid())
  requisitionId String           @map("requisition_id")
  requisition   Requisition      @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  actor         String           @db.VarChar(150)
  action        ApprovalDecision
  note          String           @default("")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([requisitionId])
  @@index([createdAt])
  @@map("requisition_activities")
}

// ---------------------------------------------------------------------------
// Integration bookkeeping
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Board approval
// ---------------------------------------------------------------------------

enum BoardApprovalStatus {
  pending
  approved
  rejected
}

enum BoardVoteStatus {
  pending
  approved
  rejected
}

/// Where a board approval currently sits in the sign-off chain.
enum BoardApprovalStage {
  corporate_hr
  chro
  board
}

model BoardGroup {
  id          String             @id @default(cuid())
  name        String             @db.VarChar(150)
  description String?            @db.VarChar(500)
  members     BoardGroupMember[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@map("board_groups")
}

model BoardGroupMember {
  groupId String     @map("group_id")
  group   BoardGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String     @map("user_id")
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt DateTime   @default(now()) @map("added_at")

  @@id([groupId, userId])
  @@map("board_group_members")
}

model BoardApproval {
  id                         String              @id @default(cuid())
  candidateId                String              @map("candidate_id")
  candidate                  Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requestedById              String              @map("requested_by_id")
  requestedBy                User                @relation("BoardApprovalRequester", fields: [requestedById], references: [id])
  status                     BoardApprovalStatus @default(pending)
  /// Which link in the chain is currently being waited on.
  currentStage               BoardApprovalStage  @default(board) @map("current_stage")
  /// The Corporate HR the requester chose to sign off. Several people hold the
  /// role, so the first link names one rather than mailing them all.
  corporateHrId              String?             @map("corporate_hr_id")
  corporateHr                User?               @relation("BoardApprovalCorporateHr", fields: [corporateHrId], references: [id], onDelete: SetNull)
  /// The CHRO chosen to sign the second link.
  chroId                     String?             @map("chro_id")
  chro                       User?               @relation("BoardApprovalChro", fields: [chroId], references: [id], onDelete: SetNull)
  /// Board members picked when the request was raised. They are only emailed
  /// once the chain reaches the board stage.
  boardMemberIds             String[]            @map("board_member_ids")
  rejectedReason             String?             @map("rejected_reason")
  rejectedAt                 DateTime?           @map("rejected_at")
  votes                      BoardApprovalVote[]
  hrApprovedById             String?             @map("hr_approved_by_id")
  hrApprovedBy               User?               @relation("BoardApprovalHrApprover", fields: [hrApprovedById], references: [id], onDelete: SetNull)
  hrApprovalNote             String?             @map("hr_approval_note") @db.VarChar(500)
  /// Required whenever HR approves on the board's behalf (not needed for a real board member's vote) — justifying documentation.
  hrApprovalAttachmentFileId String?             @map("hr_approval_attachment_file_id")
  hrApprovalAttachmentUrl    String?             @map("hr_approval_attachment_url")
  hrApprovalAttachmentName   String?             @map("hr_approval_attachment_name")
  hrApprovedAt               DateTime?           @map("hr_approved_at")
  /// Sheet columns the system holds no structured field for. Seeded from the
  /// CV screening extract when the row first appears on Corporate HR's desk,
  /// then correctable by them — an AI reading of a CV is a starting point, not
  /// something to put before the board unchecked.
  sheetEducation             String?             @map("sheet_education")
  sheetExperience            String?             @map("sheet_experience") @db.VarChar(60)
  sheetLastOrg               String?             @map("sheet_last_org") @db.VarChar(200)
  /// Set once Corporate HR puts this candidate onto an approval sheet. From
  /// that point the CHRO and board links are decided for the sheet as a whole,
  /// not per candidate.
  batchId                    String?             @map("batch_id")
  batch                      BoardApprovalBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")

  @@index([batchId])
  @@map("board_approvals")
}

/// One hiring approval sheet — several candidates that Corporate HR sends
/// onward together, mirroring DBL's paper "Hiring Approval Sheet".
///
/// The recruiter still forwards candidates one at a time; batching starts at
/// Corporate HR, who gathers whoever is waiting and sends one sheet to the
/// CHRO and then to the board. The sheet is decided as a whole, the way the
/// paper form is signed at the bottom.
model BoardApprovalBatch {
  id             String              @id @default(cuid())
  /// Human-facing reference shown on the sheet, e.g. "HAS-2026-0007".
  reference      String              @unique @db.VarChar(30)
  createdById    String              @map("created_by_id")
  createdBy      User                @relation("BoardBatchCreatedBy", fields: [createdById], references: [id])
  status         BoardApprovalStatus @default(pending)
  /// Which link the sheet is waiting on — chro, then board.
  currentStage   BoardApprovalStage  @default(chro) @map("current_stage")
  chroId         String?             @map("chro_id")
  chro           User?               @relation("BoardBatchChro", fields: [chroId], references: [id], onDelete: SetNull)
  boardMemberIds String[]            @map("board_member_ids")
  rejectedReason String?             @map("rejected_reason")
  rejectedAt     DateTime?           @map("rejected_at")
  approvals      BoardApproval[]
  votes          BoardApprovalVote[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@map("board_approval_batches")
}

model BoardApprovalVote {
  id              String              @id @default(cuid())
  /// Exactly one of these is set: a vote is cast either on one candidate's
  /// approval (the recruiter → Corporate HR link) or on a whole sheet.
  boardApprovalId String?             @map("board_approval_id")
  boardApproval   BoardApproval?      @relation(fields: [boardApprovalId], references: [id], onDelete: Cascade)
  batchId         String?             @map("batch_id")
  batch           BoardApprovalBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId          String              @map("user_id")
  user            User                @relation(fields: [userId], references: [id])
  /// Legacy raw token; null for anything issued since hashing was introduced.
  token           String?             @unique @db.VarChar(64)
  /// SHA-256 of the raw token — what lookups match on.
  tokenHash       String?             @unique @map("token_hash") @db.VarChar(64)
  tokenExpiresAt  DateTime            @map("token_expires_at")
  /// Which link in the chain this vote belongs to.
  stage           BoardApprovalStage  @default(board)
  status          BoardVoteStatus     @default(pending)
  notes           String?
  respondedAt     DateTime?           @map("responded_at")

  @@index([batchId])
  @@map("board_approval_votes")
}

/// Post-selection provisioning: HR notifies whoever will physically arrange a
/// confirmed facility (Laptop/Desktop → IT, Transport/Dormitory/Seating →
/// Admin) by email; each recipient gets their own one-time confirmation link.
/// One or more rows per (candidate, facility) — HR can notify a single person
/// or several at once; any one of them confirming marks it arranged.
model FacilityNotification {
  id              String    @id @default(cuid())
  candidateId     String    @map("candidate_id")
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// laptopDesktop | transport | dormitory | seating
  facilityKey     String    @map("facility_key") @db.VarChar(20)
  recipientUserId String    @map("recipient_user_id")
  recipientUser   User      @relation("FacilityNotificationRecipient", fields: [recipientUserId], references: [id])
  recipientName   String    @map("recipient_name") @db.VarChar(150)
  recipientEmail  String    @map("recipient_email") @db.VarChar(254)
  /// Legacy raw token; null for anything issued since hashing was introduced.
  token           String?   @unique @db.VarChar(64)
  /// SHA-256 of the raw token — what lookups match on.
  tokenHash       String?   @unique @map("token_hash") @db.VarChar(64)
  tokenExpiresAt  DateTime  @map("token_expires_at")
  sentById        String    @map("sent_by_id")
  sentBy          User      @relation("FacilityNotificationSentBy", fields: [sentById], references: [id])
  sentAt          DateTime  @default(now()) @map("sent_at")
  confirmedAt     DateTime? @map("confirmed_at")
  confirmNote     String?   @map("confirm_note")
  /// The recipient can refuse instead of confirming — no desk free, no vehicle
  /// available, wrong person asked. Kept as its own timestamp rather than a
  /// status column so a row can never be both, and so the existing
  /// `confirmedAt IS NOT NULL` checks keep their exact meaning.
  declinedAt      DateTime? @map("declined_at")
  /// Mandatory when declining: "no" without a reason leaves HR with nothing to
  /// act on, and this is the only record of why the facility was refused.
  declineReason   String?   @map("decline_reason")

  @@index([candidateId, facilityKey])
  @@map("facility_notifications")
}

model SyncLog {
  id         String     @id @default(cuid())
  source     SyncSource @default(zinghr)
  total      Int        @default(0)
  processed  Int        @default(0)
  inserted   Int        @default(0)
  updated    Int        @default(0)
  skipped    Int        @default(0)
  failed     Int        @default(0)
  status     SyncStatus @default(running)
  message    String?
  /// Terminal-style log lines streamed to the UI.
  logs       String[]
  startedAt  DateTime   @default(now()) @map("started_at")
  finishedAt DateTime?  @map("finished_at")

  @@map("sync_logs")
}

/// Fixed dropdown vocabulary for the requisition form (departments, their
/// sections, designations, each designation's valid grades, and posting zones).
///
/// Originates from ZingHR; seeded by migration so every environment matches and
/// a correction needs no deploy. One table rather than five: the lists are the
/// same shape, and `parent` carries the only relationship that matters —
/// section -> department, subsection -> "department||section", grade -> designation.
model MasterOption {
  id        String   @id @default(cuid())
  /// department | section | subsection | designation | grade | zone
  kind      String   @db.VarChar(20)
  value     String   @db.VarChar(200)
  /// Owning value for cascading lists; "" when the list is flat. Empty string
  /// rather than NULL so the unique constraint actually bites.
  parent    String   @default("") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([kind, value, parent])
  @@index([kind, parent])
  @@map("master_options")
}

/// System-wide audit log — who did what, when, and to what.
///
/// Fed from three places: an HTTP interceptor (every mutating request), a
/// Prisma client extension (field-level before/after on the models that
/// matter), and scheduled work like the ZingHR sync, which records one summary
/// row per run rather than one per employee touched.
model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @map("created_at")
  /// Null for public token endpoints and for system work — actorName still reads correctly.
  actorId     String?  @map("actor_id")
  actor       User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Snapshot, so the log survives a rename or a deleted account.
  actorName   String   @default("Unknown") @map("actor_name") @db.VarChar(150)
  /// user | public | system
  actorType   String   @default("user") @map("actor_type") @db.VarChar(10)
  action      String   @db.VarChar(60)
  entity      String   @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  entityLabel String?  @map("entity_label") @db.VarChar(200)
  summary     String   @default("")
  /// [{ field, from, to }] — redacted for medical and pay fields.
  changes     Json?
  /// http | db | system
  source      String   @default("http") @db.VarChar(10)
  method      String?  @db.VarChar(10)
  path        String?  @db.VarChar(300)
  statusCode  Int?     @map("status_code")
  ip          String?  @db.VarChar(64)
  requestId   String?  @map("request_id") @db.VarChar(40)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([entity, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@index([action, createdAt(sort: Desc)])
  @@index([requestId])
  @@map("audit_logs")
}

/**
 * DBL's pre-employment reference check, one row per referee.
 *
 * The recruiter fills this in while on the call — it is their record of the
 * conversation, not something the referee submits — so it carries who
 * conducted it. Several referees per candidate is the norm, hence a list
 * rather than fields on Onboarding.
 *
 * The free-text answers are columns because HR reads them; the nine rating
 * scales are JSON because they are a fixed block that is only ever read back
 * as a whole, and adding a tenth should not need a migration.
 */
model ReferenceCheck {
  id                  String    @id @default(cuid())
  candidateId         String    @map("candidate_id")
  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  refereeName         String    @map("referee_name") @db.VarChar(150)
  refereeDesignation  String?   @map("referee_designation") @db.VarChar(150)
  refereeOrganization String?   @map("referee_organization") @db.VarChar(200)
  refereeEmail        String?   @map("referee_email") @db.VarChar(254)
  refereePhone        String?   @map("referee_phone") @db.VarChar(40)

  /// 1a, 1b — how long they have known the applicant, and in what capacity.
  knownDuration       String?   @map("known_duration")
  relationship        String?
  /// 2a, 2b
  strengths           String?
  weaknesses          String?
  /// 3a–3i, as { trustworthiness: 'excellent', quality: 'consistently_high', … }
  ratings             Json      @default("{}")
  /// 4–7
  handover            String?
  rehireEligible      String?   @map("rehire_eligible")
  concerns            String?
  overallComments     String?   @map("overall_comments")

  conductedById       String    @map("conducted_by_id")
  conductedBy         User      @relation("ReferenceCheckConductedBy", fields: [conductedById], references: [id], onDelete: Restrict)
  conductedAt         DateTime  @default(now()) @map("conducted_at")

  /// The completed form, filed with the candidate's joining documents.
  fileId              String?   @map("file_id")
  url                 String?

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([candidateId])
  @@map("reference_checks")
}
