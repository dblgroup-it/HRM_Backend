// DBL HRM — Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  HR_MANAGER
  MANAGEMENT
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeSource {
  ZINGHR
  MANUAL
}

enum SeatCategory {
  OFFICER
  STAFF
  WORKER
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PROFILE_GENERATED
  POSTED
}

enum RequirementType {
  EXISTING
  NEW
}

enum RequisitionSource {
  FACTORY
  HO
}

enum Priority {
  TOP
  MODERATE
  ORDINARY
}

enum EmploymentNature {
  PERMANENT
  TEMPORARY
  CONTRACTUAL
}

enum ComputerRequirement {
  NOT_APPLICABLE
  DESKTOP
  LAPTOP
}

enum SeatingArrangement {
  EXISTING
  NEW
}

enum ApprovalRole {
  DEPARTMENT_HEAD
  FACTORY_HR
  SBU_HEAD
  CORPORATE_HR
  CHRO
}

enum StepStatus {
  PENDING
  APPROVED
  REJECTED
  INFO_REQUESTED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  NEED_MORE_INFO
  ESCALATED
}

/// GLOBAL roles apply org-wide; UNIT roles are scoped to specific units.
enum RoleScope {
  GLOBAL
  UNIT
}

/// Candidate pipeline stage (Phase 2). Mirrors the Drive subfolders.
enum CandidateStage {
  APPLIED
  AI_SHORTLISTED
  SHORTLISTED
  INTERVIEW
  FINAL
  SELECTED
  REJECTED
}

/// Phase 3 assessment components in a requisition's assessment plan.
enum AssessmentType {
  WRITTEN
  EXCEL
  SKILL
  VIVA
}

enum InterviewKind {
  FIRST
  SECOND
  FINAL
}

enum InterviewMode {
  ONLINE
  OFFLINE
  PHYSICAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ExamQuestionKind {
  MCQ
  TEXT
}

enum EvalTokenStatus {
  sent
  opened
  submitted
}

enum CandidateSource {
  drive
  email
  upload
  manual
  application
  bdjobs
}

enum SyncSource {
  zinghr
}

enum SyncStatus {
  running
  success
  failed
}

enum OnboardingStatus {
  docs_pending
  docs_submitted
  offer_sent
  offer_accepted
  medical
  hr_final
  onboarded
}

enum MedicalStatus {
  pending
  cleared
  rejected
}

enum OnboardingDocStatus {
  pending
  verified
  rejected
}

// ---------------------------------------------------------------------------
// Identity & people
// ---------------------------------------------------------------------------

/// Key-value app settings (e.g. AI configuration), editable by super users.
model Setting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model User {
  id              String           @id @default(cuid())
  employeeCode    String           @unique @map("employee_code") @db.VarChar(20)
  name            String           @db.VarChar(150)
  email           String?          @db.VarChar(254)
  phone           String?          @db.VarChar(20)
  passwordHash    String           @map("password_hash") @db.VarChar(100)
  role            UserRole         @default(EMPLOYEE)
  status          UserStatus       @default(ACTIVE)
  /// Bumped on logout / password change to invalidate previously-issued JWTs.
  tokenVersion    Int              @default(0) @map("token_version")
  /// Google Drive file id of the user's profile picture (served via the avatar proxy).
  avatarFileId    String?          @map("avatar_file_id") @db.VarChar(100)
  /// Per-user toggle: also send notifications to this user's email.
  emailNotifications Boolean       @default(true) @map("email_notifications")
  /// Two-factor auth: enabled flag, method ('email' | 'totp'), and TOTP secret.
  twoFactorEnabled  Boolean        @default(false) @map("two_factor_enabled")
  twoFactorMethod   String?        @map("two_factor_method") @db.VarChar(10)
  twoFactorSecret   String?        @map("two_factor_secret") @db.VarChar(100)
  /// Transient one-time code (hashed) for email 2FA + its expiry.
  otpHash           String?        @map("otp_hash") @db.VarChar(100)
  otpExpiresAt      DateTime?      @map("otp_expires_at")
  employee        Employee?
  roleAssignments  RoleAssignment[]
  notifications    Notification[]
  committeeRoles   CommitteeMember[]
  interviewPanels  InterviewPanelist[]
  evaluations      Evaluation[]
  evaluationTokens EvaluationToken[]
  unitsCreated     Unit[]             @relation("UnitCreatedBy")
  unitsUpdated     Unit[]             @relation("UnitUpdatedBy")
  departmentsCreated Department[]     @relation("DepartmentCreatedBy")
  departmentsUpdated Department[]     @relation("DepartmentUpdatedBy")
  positionsCreated Position[]         @relation("PositionCreatedBy")
  positionsUpdated Position[]         @relation("PositionUpdatedBy")
  rolesCreated         Role[]             @relation("RoleCreatedBy")
  rolesUpdated         Role[]             @relation("RoleUpdatedBy")
  roleAssignmentsGiven RoleAssignment[]   @relation("RoleAssignedBy")
  interviewRoundsCreated InterviewRound[] @relation("InterviewRoundCreatedBy")
  candidatesCreated      Candidate[]      @relation("CandidateCreatedBy")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("users")
}

/// In-app notification, delivered live over websockets and persisted for the bell.
model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(200)
  message   String
  /// Optional frontend route to open, e.g. /requisitions/:id
  link      String?  @db.VarChar(500)
  read      Boolean   @default(false)
  seenAt    DateTime? @map("seen_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Dynamic, configurable access role (e.g. Factory HR, Department Head, CHRO).
model Role {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?
  scope       RoleScope        @default(UNIT)
  /// System roles are seeded and cannot be deleted.
  isSystem    Boolean          @default(false) @map("is_system")
  assignments RoleAssignment[]
  createdById String?          @map("created_by_id")
  createdBy   User?            @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?          @map("updated_by_id")
  updatedBy   User?            @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

/// Grants a user a role, optionally scoped to a unit (null = all units / global).
model RoleAssignment {
  id          String   @id @default(cuid())
  roleId      String   @map("role_id")
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId      String?  @map("unit_id")
  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  assignedById String? @map("assigned_by_id")
  assignedBy  User?    @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([roleId, userId, unitId])
  @@index([userId])
  @@map("role_assignments")
}

/// Organizational profile, primarily fed by the ZingHR daily sync.
model Employee {
  id              String         @id @default(cuid())
  userId          String         @unique @map("user_id")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode    String         @map("employee_code") @db.VarChar(20)
  designation     String?        @db.VarChar(150)
  department      String?        @db.VarChar(150)
  section         String?        @db.VarChar(150)
  grade           String?        @db.VarChar(50)
  category        String?        @db.VarChar(50)
  unitName        String?        @map("unit_name") @db.VarChar(200)
  unitId          String?        @map("unit_id")
  unit            Unit?          @relation(fields: [unitId], references: [id])
  location        String?        @db.VarChar(200)
  gender          String?        @db.VarChar(10)
  dateOfBirth     DateTime?      @map("date_of_birth") @db.Date
  joiningDate     DateTime?      @map("joining_date") @db.Date
  exitDate        DateTime?      @map("exit_date") @db.Date
  lineManagerName String?        @map("line_manager_name") @db.VarChar(150)
  lineManagerCode String?        @map("line_manager_code") @db.VarChar(20)
  source          EmployeeSource @default(MANUAL)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([unitId])
  @@index([department])
  @@index([unitName])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Unit configuration → drives the organogram
// ---------------------------------------------------------------------------

model Unit {
  id              String           @id @default(cuid())
  name            String           @unique @db.VarChar(200)
  isActive        Boolean          @default(true) @map("is_active")
  departments     Department[]
  positions       Position[]
  employees       Employee[]
  roleAssignments RoleAssignment[]
  createdById     String?          @map("created_by_id")
  createdBy       User?            @relation("UnitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?          @map("updated_by_id")
  updatedBy       User?            @relation("UnitUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("units")
}

model Department {
  id          String     @id @default(cuid())
  unitId      String     @map("unit_id")
  unit        Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name        String     @db.VarChar(150)
  positions   Position[]
  createdById String?    @map("created_by_id")
  createdBy   User?      @relation("DepartmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?    @map("updated_by_id")
  updatedBy   User?      @relation("DepartmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([unitId, name])
  @@map("departments")
}

/// A sanctioned seat in the organogram (unit + department + designation).
model Position {
  id           String       @id @default(cuid())
  unitId       String       @map("unit_id")
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  departmentId String       @map("department_id")
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designation  String       @db.VarChar(150)
  /// Optional section within the department (e.g. IT Support under IT).
  section      String?      @db.VarChar(150)
  category     SeatCategory @default(OFFICER)
  sanctioned   Int          @default(0)
  /// Currently occupied seats (manually maintained). vacant = sanctioned − filled.
  filled       Int          @default(0)
  createdById  String?      @map("created_by_id")
  createdBy    User?        @relation("PositionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById  String?      @map("updated_by_id")
  updatedBy    User?        @relation("PositionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@unique([unitId, departmentId, designation])
  @@map("positions")
}

// ---------------------------------------------------------------------------
// Requisition (Phase 1)
// ---------------------------------------------------------------------------

model Requisition {
  id                 String                @id @default(cuid())
  code               String                @unique @db.VarChar(20)
  designation        String                @db.VarChar(150)
  requirementType    RequirementType       @map("requirement_type")
  source             RequisitionSource
  requiredPosts      Int                   @map("required_posts")
  totalVacantPosts   Int                   @map("total_vacant_posts")
  unitFactory        String                @map("unit_factory") @db.VarChar(200)
  department         String                @db.VarChar(150)
  section            String?               @db.VarChar(150)
  placeOfPosting     String                @map("place_of_posting") @db.VarChar(200)
  vacantDate         DateTime?             @map("vacant_date") @db.Date
  neededDate         DateTime?             @map("needed_date") @db.Date
  priority           Priority              @default(MODERATE)
  employmentNature   EmploymentNature      @default(PERMANENT) @map("employment_nature")
  contractualPurpose String?               @map("contractual_purpose")
  jobDescription     String                @map("job_description")
  education          String
  experience         String
  others             String?
  computer           ComputerRequirement   @default(NOT_APPLICABLE)
  computerReason     String?               @map("computer_reason")
  seating            SeatingArrangement    @default(EXISTING)
  preferredSources   String[]              @map("preferred_sources")
  status             RequisitionStatus     @default(PENDING_APPROVAL)
  roleProfile        Json?                 @map("role_profile")
  posting            Json?
  /// AI-generated interview questions — array of { category, question }.
  interviewQuestions Json?                 @map("interview_questions")
  /// Corporate HR committee deliberation / final recommendation notes.
  deliberationNotes  String?               @map("deliberation_notes")
  raisedBy           String?               @map("raised_by") @db.VarChar(150)
  raisedById         String?               @map("raised_by_id")
  /// Phase 2: Google Drive folder ids + shareable links for this requisition's recruitment workspace.
  drive              Json?
  /// Optional supporting files (JD, approvals, etc.) — array of { name, fileId, url, size, uploadedAt }.
  attachments        Json?
  approvalSteps      ApprovalStep[]
  activities         RequisitionActivity[]
  candidates         Candidate[]
  committeeMembers   CommitteeMember[]
  rubricCriteria     RubricCriterion[]
  assessments        AssessmentComponent[]
  interviewRounds    InterviewRound[]
  examQuestions      ExamQuestion[]
  examAttempts       ExamAttempt[]
  bdJobsPost         BdJobsPost?
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  /// Soft delete — null means active; set to timestamp when "deleted".
  deletedAt          DateTime?             @map("deleted_at")

  @@index([status])
  @@index([unitFactory])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("requisitions")
}

/// BDJobs job posting record — one per requisition.
model BdJobsPost {
  id            String      @id @default(cuid())
  requisitionId String      @unique @map("requisition_id")
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  /// BDJobs assigned job ID (null until successfully posted)
  bdJobsJobId   String?     @map("bdjobs_job_id") @db.VarChar(50)
  /// draft | posted | failed
  status        String      @default("draft") @db.VarChar(20)
  /// All form fields submitted by Corporate HR
  formData      Json        @map("form_data")
  errorMessage  String?     @map("error_message")
  postedAt      DateTime?   @map("posted_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("bdjobs_posts")
}

/// A CV / applicant against a requisition (Phase 2 — CV collection).
model Candidate {
  id            String         @id @default(cuid())
  requisitionId String         @map("requisition_id")
  requisition   Requisition    @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  name          String         @db.VarChar(150)
  email         String?        @db.VarChar(254)
  phone         String?        @db.VarChar(20)
  source        CandidateSource @default(manual)
  stage         CandidateStage  @default(APPLIED)
  /// Google Drive file id + view link for the CV document.
  cvFileId      String?         @map("cv_file_id") @db.VarChar(100)
  cvUrl         String?         @map("cv_url")
  notes         String?
  salaryExpectation Float?      @map("salary_expectation")
  /// AI CV-screening: match score 0-100 against the role + a short rationale.
  matchScore    Float?          @map("match_score")
  matchSummary  String?        @map("match_summary")
  screenedAt    DateTime?      @map("screened_at")
  viewedAt      DateTime?      @map("viewed_at")
  /// Phase 3: suitable-but-not-selected candidates kept for future recall.
  talentPool    Boolean        @default(false) @map("talent_pool")
  /// Red flag: set by Corp HR / CHRO when this candidate is barred from future roles.
  isRedFlagged    Boolean      @default(false) @map("is_red_flagged")
  redFlagReason   String?      @map("red_flag_reason")
  redFlaggedAt    DateTime?    @map("red_flagged_at")
  redFlaggedById  String?      @map("red_flagged_by_id")
  createdById   String?         @map("created_by_id")
  createdBy     User?           @relation("CandidateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Bdjobs inbound: unique per Bdjobs application — used for deduplication.
  bdjobsApplicationId  String?  @unique @map("bdjobs_application_id") @db.VarChar(100)
  /// Bdjobs inbound: the applicant's Bdjobs profile ID.
  bdjobsApplicantId    String?  @map("bdjobs_applicant_id") @db.VarChar(100)
  /// Bdjobs inbound: the Bdjobs job listing ID this candidate applied to.
  bdjobsJobId          String?  @map("bdjobs_job_id") @db.VarChar(100)
  interviews    InterviewRound[]
  examAttempts  ExamAttempt[]
  onboarding    Onboarding?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  /// Soft delete — null means active; set to timestamp when "deleted".
  deletedAt     DateTime?      @map("deleted_at")

  @@index([requisitionId, stage])
  @@index([stage])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("candidates")
}

/// Registry of red-flagged identities (email + phone) for auto-flagging future applications.
model RedFlagRegistry {
  id          String    @id @default(cuid())
  /// Normalised lowercase email (may be null if only phone was known).
  email       String?   @unique @db.VarChar(254)
  /// Phone digits only (may be null if only email was known).
  phone       String?   @unique @db.VarChar(20)
  reason      String
  flaggedById String    @map("flagged_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([email])
  @@index([phone])
  @@map("red_flag_registry")
}

/// Phase 3 — a scheduled interview round for a candidate (first / second / final).
model InterviewRound {
  id               String              @id @default(cuid())
  candidateId      String              @map("candidate_id")
  candidate        Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requisitionId    String              @map("requisition_id")
  requisition      Requisition         @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  kind             InterviewKind       @default(FIRST)
  mode             InterviewMode       @default(PHYSICAL)
  scheduledAt      DateTime?           @map("scheduled_at")
  /// Venue (physical) or meeting link (online).
  location         String?             @db.VarChar(500)
  status           InterviewStatus     @default(SCHEDULED)
  /// Google Calendar sync: event id + the auto-generated Meet link (online).
  calendarEventId  String?             @map("calendar_event_id") @db.VarChar(200)
  meetLink         String?             @map("meet_link")
  questionsSentAt  DateTime?           @map("questions_sent_at")
  panelists        InterviewPanelist[]
  evaluations      Evaluation[]
  evaluationTokens EvaluationToken[]
  createdById      String?             @map("created_by_id")
  createdBy        User?               @relation("InterviewRoundCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now()) @map("created_at")

  @@index([candidateId])
  @@index([requisitionId])
  @@map("interview_rounds")
}

/// Phase 3 — a committee member assigned to an interview round's panel.
model InterviewPanelist {
  id      String         @id @default(cuid())
  roundId String         @map("round_id")
  round   InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId  String         @map("user_id")
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([userId])
  @@map("interview_panelists")
}

/// Phase 3 — a one-click secure evaluation link sent to each panelist (no login required).
model EvaluationToken {
  id             String         @id @default(cuid())
  /// Unguessable 32-char hex token (16 random bytes).
  token          String         @unique @db.VarChar(64)
  roundId        String         @map("round_id")
  round          InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  panelistUserId String         @map("panelist_user_id")
  panelistUser   User           @relation(fields: [panelistUserId], references: [id], onDelete: Cascade)
  status         EvalTokenStatus @default(sent)
  openedAt       DateTime?      @map("opened_at")
  submittedAt    DateTime?      @map("submitted_at")
  /// 48h after the interview date, or 7 days from creation when no scheduledAt.
  expiresAt      DateTime       @map("expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@unique([roundId, panelistUserId])
  @@index([roundId])
  @@map("evaluation_tokens")
}

/// Phase 3 — a question in a requisition's online exam (written / excel) bank.
model ExamQuestion {
  id            String           @id @default(cuid())
  requisitionId String           @map("requisition_id")
  requisition   Requisition      @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  examType      AssessmentType   @map("exam_type")
  kind          ExamQuestionKind @default(MCQ)
  prompt        String
  /// MCQ options, e.g. ["A", "B", "C", "D"]
  options       Json?
  /// MCQ: the correct option text. TEXT: model answer used for AI grading.
  answer        String?
  marks         Int              @default(1)
  orderIndex    Int              @default(0) @map("order_index")

  @@index([requisitionId, examType])
  @@map("exam_questions")
}

/// Phase 3 — a candidate's attempt at an online exam (token-linked, no login).
model ExamAttempt {
  id            String         @id @default(cuid())
  candidateId   String         @map("candidate_id")
  candidate     Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requisitionId String         @map("requisition_id")
  requisition   Requisition    @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  examType      AssessmentType @map("exam_type")
  /// Unguessable link token for the candidate's exam page.
  token         String         @unique @db.VarChar(64)
  /// pending | submitted | graded
  status        String         @default("pending") @db.VarChar(20)
  /// { questionId: answerText }
  answers       Json?
  /// per-question AI/auto grade: { questionId: { score, feedback } }
  grades        Json?
  autoScore     Float?         @map("auto_score")
  totalScore    Float?         @map("total_score")
  maxScore      Float          @default(0) @map("max_score")
  startedAt     DateTime?      @map("started_at")
  submittedAt   DateTime?      @map("submitted_at")
  gradedAt      DateTime?      @map("graded_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([candidateId])
  @@index([requisitionId])
  @@map("exam_attempts")
}

/// Phase 4 & 5 — document collection, verification, offer & onboarding for a
/// selected candidate. One per candidate.
model Onboarding {
  id              String          @id @default(cuid())
  candidateId     String          @unique @map("candidate_id")
  candidate       Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// Unguessable token for the candidate's document-submission + offer pages.
  token           String          @unique @db.VarChar(64)
  status          OnboardingStatus @default(docs_pending)
  offerSentAt     DateTime?       @map("offer_sent_at")
  offerAcceptedAt DateTime?       @map("offer_accepted_at")
  medicalStatus   MedicalStatus   @default(pending) @map("medical_status")
  medicalNote     String?         @map("medical_note")
  medicalClearedAt DateTime?      @map("medical_cleared_at")
  hrVerifiedAt    DateTime?       @map("hr_verified_at")
  /// AI cross-verification of submitted docs vs the candidate's profile:
  /// { verdict, overview, findings: [{doc, severity, detail}] }
  crossCheck      Json?           @map("cross_check")
  crossCheckedAt  DateTime?       @map("cross_checked_at")
  archivedAt      DateTime?       @map("archived_at")
  /// Drive folder the joining docs were moved into on archive.
  archiveFolderUrl String?        @map("archive_folder_url")
  itEmail         String?         @map("it_email") @db.VarChar(254)
  itAssetId       String?         @map("it_asset_id") @db.VarChar(50)
  itNotifiedAt    DateTime?       @map("it_notified_at")
  docs            OnboardingDoc[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("onboardings")
}

/// A document the candidate submitted (stored on Drive), with AI extraction.
model OnboardingDoc {
  id           String     @id @default(cuid())
  onboardingId String     @map("onboarding_id")
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  label        String     @db.VarChar(100)
  fileId       String     @map("file_id") @db.VarChar(100)
  url          String
  mimeType     String     @map("mime_type") @db.VarChar(100)
  status       OnboardingDocStatus @default(pending)
  /// AI (OCR + LLM) extracted structured fields.
  aiExtract    Json?      @map("ai_extract")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([onboardingId])
  @@map("onboarding_docs")
}

/// Phase 3 — one panelist's rubric scores + comments for a candidate in a round.
model Evaluation {
  id          String         @id @default(cuid())
  roundId     String         @map("round_id")
  round       InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  evaluatorId String         @map("evaluator_id")
  evaluator   User           @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  /// { rubricCriterionId: score, ... }
  scores      Json
  comments    String?
  total       Float          @default(0)
  submittedAt DateTime       @default(now()) @map("submitted_at")

  @@unique([roundId, evaluatorId])
  @@map("evaluations")
}

/// Phase 3 — a member of a requisition's interview committee (a synced user who
/// logs in to mark candidates).
model CommitteeMember {
  id            String      @id @default(cuid())
  requisitionId String      @map("requisition_id")
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// interviewer | evaluator
  role          String      @default("interviewer") @db.VarChar(20)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([requisitionId, userId])
  @@index([userId])
  @@map("committee_members")
}

/// Phase 3 — a scored criterion in a requisition's interview rubric.
model RubricCriterion {
  id            String      @id @default(cuid())
  requisitionId String      @map("requisition_id")
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  label         String      @db.VarChar(150)
  maxScore      Int         @default(10) @map("max_score")
  orderIndex    Int         @default(0) @map("order_index")

  @@map("rubric_criteria")
}

/// Phase 3 — a component of a requisition's assessment plan (written/excel/skill/viva).
model AssessmentComponent {
  id            String         @id @default(cuid())
  requisitionId String         @map("requisition_id")
  requisition   Requisition    @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  type          AssessmentType
  maxScore      Float          @default(100) @map("max_score")
  /// Display/sort order within the requisition's assessment plan (lower = shown first).
  orderIndex    Int            @default(0) @map("order_index")

  @@unique([requisitionId, type])
  @@map("assessment_components")
}

model ApprovalStep {
  id            String       @id @default(cuid())
  requisitionId String       @map("requisition_id")
  requisition   Requisition  @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  orderIndex    Int          @map("order_index")
  role          ApprovalRole
  title         String       @db.VarChar(150)
  subtitle      String       @db.VarChar(200)
  assignee      String       @default("") @db.VarChar(150)
  status        StepStatus   @default(PENDING)
  note          String       @default("")
  actedAt       DateTime?    @map("acted_at")

  @@unique([requisitionId, orderIndex])
  @@map("approval_steps")
}

model RequisitionActivity {
  id            String           @id @default(cuid())
  requisitionId String           @map("requisition_id")
  requisition   Requisition      @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  actor         String           @db.VarChar(150)
  action        ApprovalDecision
  note          String           @default("")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([requisitionId])
  @@index([createdAt])
  @@map("requisition_activities")
}

// ---------------------------------------------------------------------------
// Integration bookkeeping
// ---------------------------------------------------------------------------

model SyncLog {
  id         String    @id @default(cuid())
  source     SyncSource @default(zinghr)
  total      Int        @default(0)
  processed  Int        @default(0)
  inserted   Int        @default(0)
  updated    Int        @default(0)
  skipped    Int        @default(0)
  failed     Int        @default(0)
  status     SyncStatus @default(running)
  message    String?
  /// Terminal-style log lines streamed to the UI.
  logs       String[]
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@map("sync_logs")
}
