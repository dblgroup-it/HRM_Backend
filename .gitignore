node_modules
dist
# --- Environment files -----------------------------------------------------
# Every .env variant EXCEPT the committed template. The previous rules covered
# `.env` and `.env.*.local` only, which left `.env.production`, `.env.local`,
# `.env.bak` and similar committable — the exact files an operator creates on a
# server or when editing one by hand.
.env
.env.*
!.env.example
*.log
coverage
.DS_Store

# Database dumps — real employee data, never commit these
backups/
*.sql.gz

# One-time OAuth output — a long-lived Google credential, never commit it
google-refresh-token.txt

# Tutorial videos: large mp4s are copied to the server, not committed (videos.json, .vtt and posters are)
assets/tutorial-videos/*.mp4
