# --- Server ---
# Set to "production" on the deployed server — several safety checks in
# main.ts's validateEnv() (JWT_SECRET strength, CORS_ORIGIN, Google OAuth
# redirect) only run when this is "production".
NODE_ENV=production
PORT=4000
API_PREFIX=api
# Comma-separated list of allowed frontend origins — never "*" in production.
CORS_ORIGIN=https://your-domain.example.com
# Public origin of the frontend SPA — used to build absolute links (BDJobs
# apply links, email links, etc). Falls back to the first CORS_ORIGIN if unset.
FRONTEND_URL=https://your-domain.example.com

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dbl_hrm?schema=public"

# --- Auth ---
# Required in production: >=24 chars, not the literal default below.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# --- ZingHR integration ---
ZINGHR_BASE_URL=https://portal.zinghr.com
ZINGHR_SUBSCRIPTION_NAME=
ZINGHR_TOKEN=
# Only employees whose code starts with this prefix are imported (JTML = 151)
ZINGHR_EMPLOYEE_CODE_PREFIX=151
# Cron expression for the daily sync (default 20:36 every day)
ZINGHR_SYNC_CRON=36 20 * * *
ZINGHR_SYNC_ENABLED=true

# --- Google OAuth / Drive (Phase 2 CV collection) ---
# OAuth client for the recruitment Google account (hr.recruitment@dbl-group.com) —
# files/folders are created under that account's own Drive storage.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be your production callback URL, not localhost — main.ts refuses to
# boot in production if this is missing or contains "localhost".
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example.com/api/integrations/google/oauth/callback
# Obtained by completing the one-time consent flow at
# /api/integrations/google/oauth/start, then copied from the callback result.
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER_NAME="DBL HRM Recruitment"

# --- Mail (Gmail SMTP via the recruitment account's app password) ---
MAIL_USER=hr.recruitment@dbl-group.com
MAIL_APP_PASSWORD=
MAIL_FROM="DBL Group Recruitment <hr.recruitment@dbl-group.com>"

# --- BDJobs job-export API (Configuration → provided by BDJobs) ---
BDJOBS_BASE_URL=https://application.bdjobs.com/v1
BDJOBS_AUTH_TOKEN=
BDJOBS_COMPANY_ID=
BDJOBS_DECODE_ID=
# Order BDJobs hashes into X-Api-AuthToken (SHA-256). Placeholders: {token} {decodeId} {companyId} {ts}
BDJOBS_SIGNATURE_FORMAT={token}&^^{decodeId}*&*{ts}

# --- AI (role-profile generation, screening, comparisons) ---
# "anthropic" or "gemini"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Misc ---
# Optional — webhook URL notified on IT-provisioning events, if used.
IT_WEBHOOK_URL=
# Days an approval can sit pending before a nudge notification fires.
NUDGE_APPROVAL_DAYS=3
